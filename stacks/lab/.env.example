# A local lab: copy to .env and `docker compose up -d --wait`.
# A deployment changes this file and nothing else.

# Where the lab answers. LAB_URL is what a browser types, port included unless 443.
LAB_DOMAIN=lab.localhost
LAB_URL=https://lab.localhost:8443
LAB_BIND=127.0.0.1
LAB_PORT=8443

# The certificate: a directory with fullchain.pem and privkey.pem, or the
# volume name `certs`, where a self-signed one is made on the first start.
LAB_CERTS=certs

# The first account, made on the first start only, when there are none.
# Clear the password after that; more accounts: see README.
LAB_FIRST_USER=alice
LAB_FIRST_EMAIL=alice@example.com
LAB_FIRST_PASSWORD=alice-lab

# Mail. Locally Mailpit catches all of it (http://localhost:8025);
# a deployment drops the profile and names a relay.
COMPOSE_PROFILES=mailpit
LAB_MAILPIT_PORT=8025
LAB_SMTP_ADDRESS=smtp://mailpit:1025
LAB_SMTP_SENDER=lab <lab@example.com>
LAB_SMTP_USERNAME=
LAB_SMTP_PASSWORD=
LAB_SMTP_SKIP_VERIFY=true

# Models. LiteLLM's key, which the mind sends it; the model the mind asks
# for (fake, chat, lite: litellm/models.yaml); and the providers' keys, which
# only the real models need. LAB_LLM_CONFIG names another model list.
LAB_LLM_KEY=sk-lab-local
LAB_LLM_MODEL=fake
LAB_LLM_CONFIG=./litellm/models.yaml
LAB_SYSTEM_PROMPT=
# The MCP servers whose tools the model may call, name=url,...; none when
# empty. MCP's reference server runs under the `everything` profile:
# COMPOSE_PROFILES=mailpit,everything and
# LAB_MCP_SERVERS=everything=http://everything:3001/mcp
LAB_MCP_SERVERS=
# Sound, turn by turn, which the mind hands on to LiteLLM: the model that
# transcribes (fake-stt, stt), the one that speaks (fake-tts, tts) and its
# voice when the page names none (OpenAI asks for one; LiteLLM maps
# OpenAI's names to Gemini's). Empty models: the face has no mic or read-aloud.
LAB_STT_MODEL=fake-stt
LAB_TTS_MODEL=fake-tts
LAB_TTS_VOICE=alloy
# Our speech engines. piper and silero run here under the `engines` profile
# (COMPOSE_PROFILES=...,engines; silero's image is Intel's, LAB_SILERO_ACCEL
# xpu, cpu falls back by itself, or cuda). The GPU ones run elsewhere: whisper
# (model whisper-gpu, stt's fallback), voxcpm, and Ollama (model local), each
# at its URL with /v1 (Ollama without); empty: those models are offered and
# fail when asked.
LAB_SILERO_ACCEL=xpu
LAB_STT_GPU_URL=
LAB_VOXCPM_URL=
LAB_OLLAMA_URL=
# The model a call goes to (the mind's REALTIME_MODEL): fake-realtime,
# fake-realtime-full, cascade; empty: no call.
LAB_REALTIME_MODEL=fake-realtime
# cascade, our own (minds/realtime): its ear, chat model and voice are what
# the page picks in the sidebar; these when it names none (hearing's ear,
# the chat model, speaking's <model>_<voice>). Then the instructions, and
# how hearing finds speech (energy, or silero with its VAD at vad).
LAB_CASCADE_STT_MODEL=fake-stt
LAB_CASCADE_LLM_MODEL=fake
LAB_CASCADE_VOICE=fake-tts_alloy
LAB_CASCADE_PROMPT=
LAB_CASCADE_VAD=energy
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=
ZAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
