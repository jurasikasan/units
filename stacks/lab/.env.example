# A local lab: copy to .env and `docker compose up -d --wait`.
# A deployment changes this file and nothing else.

# Where the lab answers. LAB_URL is what a browser types, port included unless 443.
LAB_DOMAIN=lab.localhost
LAB_URL=https://lab.localhost:8443
LAB_BIND=127.0.0.1
LAB_PORT=8443

# The certificate: a directory with fullchain.pem and privkey.pem, or the
# volume name `certs`, where a self-signed one is made on the first start.
LAB_CERTS=certs

# The first account, made on the first start only, when there are none.
# Clear the password after that; more accounts: see README.
LAB_FIRST_USER=alice
LAB_FIRST_EMAIL=alice@example.com
LAB_FIRST_PASSWORD=alice-lab

# Mail. Locally Mailpit catches all of it (http://localhost:8025);
# a deployment drops the profile and names a relay.
COMPOSE_PROFILES=mailpit
LAB_MAILPIT_PORT=8025
LAB_SMTP_ADDRESS=smtp://mailpit:1025
LAB_SMTP_SENDER=lab <lab@example.com>
LAB_SMTP_USERNAME=
LAB_SMTP_PASSWORD=
LAB_SMTP_SKIP_VERIFY=true
