# The nightly: its watch (compose.yaml) and its jobs (run.sh). Copied to
# .env as is, it works on this machine: messages go to a fake Telegram
# that prints them. A deployment sets the bot's token and the chat, and
# empties TELEGRAM_API_BASE and COMPOSE_PROFILES.
COMPOSE_PROFILES=fake_telegram
# The label every message starts with.
NIGHTLY_NAME=lab-nightly
TELEGRAM_TOKEN=fake
TELEGRAM_CHAT_ID=0
TELEGRAM_API_BASE=http://fake_telegram:8080
# What a job runs on: a ref of this checkout's repository, checked out
# afresh in a throwaway worktree. Fetched from origin first unless
# NIGHTLY_FETCH=no.
NIGHTLY_REF=origin/main
NIGHTLY_FETCH=yes
# Where the logs and reports go; empty: _ignored/nightly in this checkout.
NIGHTLY_REPORTS=
# How many days of them are kept.
NIGHTLY_KEEP_DAYS=30
