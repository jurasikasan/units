# A systemd user unit: one run of a nightly job (run.sh <job>), the job
# its instance name (lab-nightly@e2e). Copied to ~/.config/systemd/user/ with
# <units-checkout> replaced; stacks/lab/README.md, "Nightly", has the steps.
[Unit]
Description=lab nightly: %i
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=<units-checkout>/stacks/lab/nightly/run.sh %i
# The e2e builds every image and runs a lab: give it its time.
TimeoutStartSec=3h
Nice=10
