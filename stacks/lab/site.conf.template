server {
    listen 443 ssl;
    server_name ${LAB_DOMAIN};
    ssl_certificate     /certs/fullchain.pem;
    ssl_certificate_key /certs/privkey.pem;

    include /etc/nginx/gate/authz.conf;

    location /auth {
        include /etc/nginx/gate/portal.conf;
    }
    location /api/ {
        include /etc/nginx/gate/api.conf;
        proxy_pass http://app;
    }
    location / {
        include /etc/nginx/gate/page.conf;
        proxy_pass http://app;
    }
}
