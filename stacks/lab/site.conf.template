server {
    listen 443 ssl;
    server_name ${LAB_DOMAIN};
    ssl_certificate     /certs/fullchain.pem;
    ssl_certificate_key /certs/privkey.pem;

    # Docker's DNS, asked as requests come: a recreated service is found at
    # its new address. Services are named through variables for that.
    resolver 127.0.0.11 valid=1s;
    include /etc/nginx/gate/authz.conf;

    location /auth {
        include /etc/nginx/gate/portal.conf;
    }
    # Where a program's code is shown to the person who let it in.
    location = /gate/code {
        include /etc/nginx/gate/code.conf;
    }
    # Who is logged in and where to log out, for the face: gate's answer.
    location = /api/v1/userinfo {
        include /etc/nginx/gate/userinfo.conf;
    }
    # The mind; /api/run reaches it as /run, for any AG-UI client (the face
    # runs none: the driver asks the mind inside the stack). A run carries
    # attachments inline: the mind takes up to 16 MB.
    # Sound, turn by turn: a recording up to OpenAI's 25 MB goes on as it
    # comes, and speech comes back as it is made.
    location /api/v1/audio/ {
        include /etc/nginx/gate/api.conf;
        client_max_body_size 25m;
        proxy_request_buffering off;
        proxy_buffering off;
        set $mind mind:8088;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$mind;
        proxy_read_timeout 120s;
    }
    # A call: a WebSocket to the mind's /v1/realtime, open as long as the
    # call lasts (an hour without a message ends it).
    location = /api/v1/realtime {
        include /etc/nginx/gate/api.conf;
        set $mind mind:8088;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$mind;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
    # reins: which subjects the person steers, and the world through them;
    # /api/reins/me/subjects reaches it as /me/subjects. An entry carries
    # pictures and files inline: reins takes 16 MB.
    location /api/reins/ {
        include /etc/nginx/gate/api.conf;
        client_max_body_size 16m;
        set $reins reins:8087;
        rewrite ^/api/reins/(.*)$ /$1 break;
        proxy_pass http://$reins;
    }
    # The person's stream: server-sent events, each passed on as it comes,
    # open for as long as the page is (a keep-alive every 15 s).
    location = /api/reins/me/stream {
        include /etc/nginx/gate/api.conf;
        set $reins reins:8087;
        rewrite ^/api/reins/(.*)$ /$1 break;
        proxy_pass http://$reins;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 1h;
    }
    location /api/ {
        include /etc/nginx/gate/api.conf;
        client_max_body_size 16m;
        set $mind mind:8088;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$mind;
        proxy_read_timeout 300s;
    }
    location / {
        include /etc/nginx/gate/page.conf;
        set $face face;
        proxy_pass http://$face;
    }
}
