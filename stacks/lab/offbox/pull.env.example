# offbox/pull.sh's settings on the machine that keeps the copy. Copy to
# _ignored/lab-pull.env in this checkout (gitignored) and fill in; nothing
# real belongs in this tracked file.

# The box, as SSH reaches it: an alias in ~/.ssh/config, key-based, no
# password prompt (the timer runs unattended). Empty: the lab is on this
# machine, run without SSH.
LAB_PULL_SSH=<ssh-alias-of-the-box>
# The lab's directory on the box: stacks/lab in the units checkout there.
LAB_PULL_LAB=<path-on-the-box>/units/stacks/lab
# Where the copy is kept here: dumps/, bytes/, last-good. Never pruned.
LAB_PULL_DEST=<path-here>/lab-backups

# Hours between pulls (the timer fires hourly), and after which the copy is
# called stale.
LAB_PULL_EVERY=20
LAB_PULL_STALE=24
# yes: a fresh dump on the box before each pull (gate and the databases
# stop for the seconds it takes); no: only what the box already holds.
LAB_PULL_DUMP=yes
# The desktop notification's command; empty for none.
LAB_PULL_NOTIFY=notify-send
