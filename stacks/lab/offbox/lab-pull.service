# A systemd user unit: one pull of the lab's backups off its box
# (offbox/pull.sh). Copied to ~/.config/systemd/user/ with <units-checkout>
# replaced; stacks/lab/README.md, "Off the box", has the steps.
[Unit]
Description=lab's backups pulled off the box
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=<units-checkout>/stacks/lab/offbox/pull.sh
