# Fires lab-pull.service hourly, and soon after the machine wakes or boots
# when an hour was missed; the pull itself decides whether LAB_PULL_EVERY
# hours have passed since the last good one.
[Unit]
Description=lab's backups pulled off the box, hourly

[Timer]
OnCalendar=hourly
Persistent=true
RandomizedDelaySec=5m

[Install]
WantedBy=timers.target
