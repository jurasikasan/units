{
  "name": "speech-b",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/v1/audio/speech",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.model",
          "equalTo": "fake-tts-b"
        }
      },
      {
        "matchesJsonPath": {
          "expression": "$.voice",
          "matches": "denis|irina"
        }
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "audio/wav"
    },
    "base64Body": ""
  }
}
