{
  "name": "speech-b-no_voice",
  "priority": 2,
  "request": {
    "method": "POST",
    "urlPath": "/v1/audio/speech",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.model",
          "equalTo": "fake-tts-b"
        }
      }
    ]
  },
  "response": {
    "status": 400,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "error": {
        "message": "no such voice: the second fake mouth has denis and irina",
        "type": "invalid_request_error",
        "code": "400"
      }
    }
  }
}
