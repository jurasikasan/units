{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "The registry of subjects: who exists, how they are addressed\n(nick), what they are and their preferences, a JSON object\nstored as it came. Own database on its own network.",
        "title": "Subjects",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8083",
    "paths": {
        "/health": {
            "get": {
                "description": "Answers if the process is serving HTTP at all, and says nothing\nabout Postgres; scripts/stack_version.py reads the version.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Liveness probe and build version",
                "responses": {
                    "200": {
                        "description": "status and version",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/ready": {
            "get": {
                "description": "200 when a ping to Postgres succeeds, 503 when it does not;\nthe compose healthcheck asks this one.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Readiness probe: can this instance reach Postgres",
                "responses": {
                    "200": {
                        "description": "status ok",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "503": {
                        "description": "status unavailable and the ping error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/subjects": {
            "get": {
                "description": "Retrieves a list of all subjects",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "subjects"
                ],
                "summary": "Get all subjects",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/subject.Subject"
                            }
                        }
                    },
                    "500": {
                        "description": "Failed to get subjects",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "post": {
                "description": "Creates a new subject with the provided details",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "subjects"
                ],
                "summary": "Create a new subject",
                "parameters": [
                    {
                        "description": "Subject details",
                        "name": "subject",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/subject.Subject"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/subject.Subject"
                        }
                    },
                    "400": {
                        "description": "Invalid request body, an empty subject_type, preferences that are not an object, or the nick breaks its rules",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "409": {
                        "description": "The nick is taken",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Failed to create subject",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/subjects/{id}": {
            "get": {
                "description": "Retrieves a subject based on the ID provided in the path.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "subjects"
                ],
                "summary": "Get a single subject by its ID",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Subject ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/subject.Subject"
                        }
                    },
                    "400": {
                        "description": "Invalid subject ID format or Subject ID is required",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Subject not found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Failed to get subject",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "put": {
                "description": "Updates an existing subject. The body replaces the subject:",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "subjects"
                ],
                "summary": "Update a subject",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Subject ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Subject details",
                        "name": "subject",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/subject.Subject"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/subject.Subject"
                        }
                    },
                    "400": {
                        "description": "Invalid subject ID format, Invalid request body, an empty subject_type, preferences that are not an object, or an attempt to change the nick",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Subject not found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Failed to update subject",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "delete": {
                "description": "Deletes a subject by its ID",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "subjects"
                ],
                "summary": "Delete a subject",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Subject ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Status of deletion",
                        "schema": {
                            "type": "object"
                        }
                    },
                    "400": {
                        "description": "Invalid subject ID format or Subject ID is required",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Subject not found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Failed to delete subject",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "subject.Subject": {
            "type": "object",
            "properties": {
                "bio": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "nick": {
                    "description": "Nick is how people and models address a subject: unique across every\nsubject ever created, deleted ones included, so a nick never comes to\nmean somebody else; set once at creation and never changed. The\ndatabase holds both rules (migrations/0001); the service only says why.",
                    "type": "string"
                },
                "preferences": {
                    "description": "Preferences is a JSON object this service stores and returns as it came.\nIts keys belong to whoever reads them; the registry never looks inside.",
                    "type": "object"
                },
                "subject_type": {
                    "type": "string"
                }
            }
        }
    }
}